---
import { companies } from '../data/services';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="trust">
  <div class="container">
    <p class="trust-label reveal">{t('trust.title')}</p>
    <div class="trust-list reveal">
      {companies.map((c) => <span class="trust-item">{c}</span>)}
    </div>
  </div>
</section>
