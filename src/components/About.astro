---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { num: 3, suffix: '+', label: t('about.stat.years') },
  { num: 4, suffix: '', label: t('about.stat.plugins') },
  { num: 1, suffix: '', label: t('about.stat.extension') },
  { num: 1, suffix: '', label: t('about.stat.theme') },
];
---

<section id="about">
  <div class="container">
    <h2 class="section-title reveal">{t('about.title')}</h2>
    <div class="about-text reveal">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
    </div>
    <div class="stats reveal">
      {stats.map((s) => (
        <div class="stat">
          <div class="num" data-num={s.num} data-suffix={s.suffix}>{s.num}{s.suffix}</div>
          <div class="lbl">{s.label}</div>
        </div>
      ))}
    </div>
    <div class="info-cards reveal">
      <div class="info-card">
        <h3>{t('about.edu.title')}</h3>
        <p>{t('about.edu.text')}</p>
      </div>
      <div class="info-card">
        <h3>{t('about.lang.title')}</h3>
        <p>{t('about.lang.text')}</p>
      </div>
    </div>
    <a
      class="index-card method-card reveal"
      href={getRelativeLocaleUrl(lang, 'yohacase')}
    >
      <span class="idx-path">~/method/yohacase</span>
      <h3>{t('about.method.title')}</h3>
      <p>{t('about.method.text')}</p>
      <span class="idx-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>
