---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = getRelativeLocaleUrl(lang);
const links = ['about', 'experience', 'projects', 'skills', 'contact'] as const;

// Current route without base or locale prefix — used for the active state
// and to keep the language toggle on the same page.
const base = import.meta.env.BASE_URL;
let rel = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;
rel = rel.replace(/^\//, '').replace(/\/$/, '');
const route = lang === 'en' ? rel.replace(/^en\/?/, '') : rel;
const segment = route.split('/')[0];
const activeKey = segment === 'work' ? 'projects' : segment;
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={homeUrl}>
      <span class="prompt">~</span>/cupello<span class="caret">_</span>
    </a>
    <ul class="nav-links" id="nav-links">
      {links.map((a) => (
        <li>
          <a
            href={getRelativeLocaleUrl(lang, a)}
            class={activeKey === a ? 'active' : ''}
            aria-current={activeKey === a ? 'page' : undefined}
          >
            {t(`nav.${a}`)}
          </a>
        </li>
      ))}
      <li>
        <a
          href={getRelativeLocaleUrl(lang, 'yohacase')}
          class={activeKey === 'yohacase' ? 'active' : ''}
          aria-current={activeKey === 'yohacase' ? 'page' : undefined}
        >
          {t('nav.method')}
        </a>
      </li>
    </ul>
    <div class="nav-actions">
      <button class="theme-toggle" data-theme-toggle aria-label={t('theme.toggle')}>
        <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
      </button>
      <button class="cmdk-trigger" data-cmdk-open aria-label="Command palette (Ctrl K)">
        <span class="kbd">Ctrl K</span>
      </button>
      <div class="lang-toggle">
        <a href={getRelativeLocaleUrl('es', route)} class={lang === 'es' ? 'active' : ''}>ES</a>
        <a href={getRelativeLocaleUrl('en', route)} class={lang === 'en' ? 'active' : ''}>EN</a>
      </div>
      <a
        class="gh-icon"
        href="https://github.com/Jesusdev-cup"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <a
        class="gh-icon"
        href="https://www.linkedin.com/in/gabriel-cupello-904301330/"
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
        </svg>
      </a>
      <button
        class="menu-toggle"
        data-menu-toggle
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  function initTheme() {
    const btn = document.querySelector<HTMLElement>('[data-theme-toggle]');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('jg-theme', next);
      } catch {}
    });
  }

  initTheme();
  document.addEventListener('astro:page-load', initTheme);

  function initMenu() {
    const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
    const links = document.getElementById('nav-links');
    if (!toggle || !links || toggle.dataset.bound) return;
    toggle.dataset.bound = '1';

    const close = () => {
      links.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    links.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    // Global close handlers — bound once for the session
    if (!(window as any).__menuGlobal) {
      (window as any).__menuGlobal = true;
      const closeAll = () => {
        document
          .querySelectorAll('.nav-links.open')
          .forEach((l) => l.classList.remove('open'));
        document
          .querySelectorAll('[data-menu-toggle]')
          .forEach((b) => b.setAttribute('aria-expanded', 'false'));
      };
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAll();
      });
      window
        .matchMedia('(min-width: 861px)')
        .addEventListener('change', (e) => {
          if (e.matches) closeAll();
        });
    }
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
