{
  "manifest_version": 3,
  "name": "arc-time-entries",
  "version": "1.0.0",
  "description": "Time entries — popup UI over a service-worker domain.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
