{
    "name": "arc/time-entries",
    "description": "Domain package for time entries — PSR-4 autoloaded, contracts-first.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "psr/event-dispatcher": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Arc\\TimeEntries\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arc\\TimeEntries\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    }
}
